# Copy this file to .env and fill in the required values.
# Process environment variables take precedence over .env.
REASONING_API_KEY=sk-your-key-here
REASONING_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=deepseek-v4.1-flash-1017
# 网关参数能力档位：
#   deepseek —— DeepSeek 官方 / 阿里云 compatible-mode，下发私有字段
#               `thinking: {"type": "enabled"|"disabled"}`，effort 支持 minimal|low|medium|high|max
#   openai   —— 严格校验 /v1/chat/completions 的网关（如 AMD developer 网关），
#               使用 ChatOpenAI、不发送私有 `thinking` 字段，effort 仅支持 minimal|low|medium|high
REASONING_PARAM_PROFILE=deepseek
REASONING_THINKING=enabled
REASONING_EFFORT=max
REASONING_TEMPERATURE=0.1
# 官方窗口 1M；这里按 512K 规划，给 reasoning + 正文留出稳定预算。
# 该值是 prompt + completion 的规划预算，确认厂商口径后可调整。
REASONING_CONTEXT_WINDOW=524288
REASONING_MAX_OUTPUT_TOKENS=48000
REASONING_MIN_THINKING_OUTPUT_TOKENS=40960
REASONING_HISTORY_KEEP=2
LANGSMITH_TRACING=false

# Kernel source tree used for source-level verification (read_source /
# list_writers / git_history). Point at an unpacked tree that matches the
# analysed kernel, or at a directory holding one sub-tree per version.
# The per-request --kernel-source-root argument takes precedence over this.
# Leave empty to disable source correlation; the agent will then say the source
# could not be verified instead of quoting kernel code from memory.
# KERNEL_SOURCE_ROOT=/data/kernel-src/4.18.0-305.130.1.el8_4.x86_64
KERNEL_SOURCE_ROOT=
# Optional hardening: comma-separated roots a request-supplied path must stay
# inside. Empty means "any existing kernel source tree on this host".
# KERNEL_SOURCE_ALLOWED_ROOTS=/data/kernel-src
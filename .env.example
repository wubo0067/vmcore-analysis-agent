# Copy this file to .env and fill in the required values.
# Process environment variables take precedence over .env.
REASONING_API_KEY=sk-your-key-here
REASONING_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=deepseek-v4.1-flash-1017
# 网关参数能力档位：
#   deepseek —— DeepSeek 官方 / 阿里云 compatible-mode，下发私有字段
#               `thinking: {"type": "enabled"|"disabled"}`，effort 支持 minimal|low|medium|high|max
#   openai   —— 严格校验 /v1/chat/completions 的网关（如 AMD developer 网关），
#               使用 ChatOpenAI、不发送私有 `thinking` 字段，effort 仅支持 minimal|low|medium|high
REASONING_PARAM_PROFILE=deepseek
REASONING_THINKING=enabled
REASONING_EFFORT=max
REASONING_TEMPERATURE=0.1
# 官方窗口 1M；这里按 512K 规划，给 reasoning + 正文留出稳定预算。
# 该值是 prompt + completion 的规划预算，确认厂商口径后可调整。
REASONING_CONTEXT_WINDOW=524288
REASONING_MAX_OUTPUT_TOKENS=48000
REASONING_MIN_THINKING_OUTPUT_TOKENS=40960
REASONING_HISTORY_KEEP=2
LANGSMITH_TRACING=false

# 长度失败熔断阈值：单次分析中 max_tokens 失败达到该次数后，
# 后续调用改用下方的降级预算，避免反复耗费数分钟后仍失败。
# 设为 0 可禁用熔断。
# 单次分析中 max_tokens 失败达到此次数后，后续调用启用降级配置。
# 2 表示：同一次分析运行中，累计发生 2 次输出达到 max_tokens 上限的失败后，后续调用启用降级配置（关闭 thinking、降低推理强度并限制输出 token 数）。
# 例如设为 1，第一次长度失败后的后续调用就会降级；设为 0 则禁用熔断。
REASONING_LENGTH_FAILURE_THRESHOLD=2
# 降级调用的最大输出 token 数。
REASONING_DEGRADED_MAX_OUTPUT_TOKENS=16000
# 降级调用使用的推理强度。
REASONING_DEGRADED_REASONING_EFFORT=low
# 降级调用是否启用 thinking。
REASONING_DEGRADED_THINKING=false

# Kernel source tree used for source-level verification (read_source /
# list_writers / git_history). Point at an unpacked tree that matches the
# analysed kernel, or at a directory holding one sub-tree per version.
# The per-request --kernel-source-root argument takes precedence over this.
# Leave empty to disable source correlation; the agent will then say the source
# could not be verified instead of quoting kernel code from memory.
# KERNEL_SOURCE_ROOT=/data/kernel-src/4.18.0-305.130.1.el8_4.x86_64
KERNEL_SOURCE_ROOT=
# Optional hardening: comma-separated roots a request-supplied path must stay
# inside. Empty means "any existing kernel source tree on this host".
# KERNEL_SOURCE_ALLOWED_ROOTS=/data/kernel-src

# ---------------------------------------------------------------------------
# Persistent Crash Daemon (perf/crash-persistent-session-pool)
# ---------------------------------------------------------------------------
# Crash 执行模式：
#   daemon  —— 跨进程共享守护进程模式（默认；跨 ReAct 轮次、跨 crash/stack_canary/lock_hang
#              MCP Server、多客户端共享常驻 crash 进程，需先通过 tools/crash-daemon.sh start 启动）
#   oneshot —— 兜底回退为旧版短生命周期子进程（Windows 开发/CI，零后台进程）
# 说明：旧值 "pool" 已移除（stdio 下 MCP 子进程每轮起停，进程内池无法跨轮存活），
# 显式配置 pool 会回退为 daemon；daemon 不可达时快速失败并提示启动命令。
CRASH_EXECUTION_MODE=daemon
# daemon 模式下的本地通信地址，支持 unix:///path/to.sock 或 http://127.0.0.1:8765。
# 安全说明：http:// 形式无鉴权，仅限可信单租户主机；多用户主机请使用 unix://（daemon 会自动将 socket 权限收紧为 0600）。
CRASH_DAEMON_ENDPOINT=unix:///tmp/vmcore_crashd.sock

# 以下 CRASH_POOL_* 参数由常驻 crash-daemon 进程内部的 CrashSessionPool 读取：
# 全局常驻 crash 进程上限（按宿主机每 8~12 GB 可用内存分配 1 个会话估算，超出后 LRU 淘汰空闲会话）。
CRASH_POOL_MAX_SESSIONS=4
# 单个 (vmcore, vmlinux) 允许并行持有的常驻进程槽位数（默认 1 足够；超高并发同库查询可设 2）。
CRASH_POOL_SLOTS_PER_VMCORE=1
# 空闲会话超时自动回收时间（秒），默认 900s（15 分钟）。
CRASH_POOL_IDLE_TTL_SEC=900
# 后台回收线程扫描空闲会话的周期（秒）。
CRASH_POOL_REAP_INTERVAL_SEC=60
# 所有会话槽位均忙碌时的最大排队等待时间（秒，建议 >= CRASH_STARTUP_TIMEOUT_SEC）。
CRASH_POOL_ACQUIRE_TIMEOUT_SEC=120

# 单条 crash 命令或脚本执行超时（秒）；超时后先发 SIGINT（3s 预算）挽救会话，失败再重建。
CRASH_COMMAND_TIMEOUT_SEC=180
# 大型 vmcore 首次冷启动加载 vmlinux 符号的等待上限（秒）。
CRASH_STARTUP_TIMEOUT_SEC=120
# 单次命令输出最大字符数（超出后自动截断以防 LLM 上下文溢出）。
CRASH_MAX_OUTPUT_CHARS=40000
# crash 可执行文件路径（默认从 PATH 查找）。
CRASH_BINARY=crash
# 仅用于非 RHEL 9 的开发/测试机显式跳过发行版检查（生产环境保持 false）。
# CRASH_SKIP_DISTRO_CHECK=false

# Crash MCP Server 并发控制与多客户端常驻 HTTP 传输（默认仍为 stdio，按需取消注释启用）
# 注意：daemon 模式下真正的并发上限在守护进程侧（MAX_SESSIONS * SLOTS_PER_VMCORE），此值应配合池容量调小，避免排队超时。
CRASH_MCP_MAX_CONCURRENCY=8
# 服务端 transport：stdio（默认）| streamable-http | http | sse，由 fastmcp 2.x 校验取值。
# 注意连字符：服务端用 streamable-http（短横线）。
# CRASH_MCP_TRANSPORT=streamable-http
# CRASH_MCP_HOST=127.0.0.1
# CRASH_MCP_PORT=8766
# 客户端侧：langchain 适配器的 transport 用下划线 streamable_http，与服务端拼写不同，勿混用。
# CRASH_MCP_URL=http://127.0.0.1:8766/mcp
# CRASH_MCP_CLIENT_TRANSPORT=streamable_http